/* issue 1971 - begin - communityforums_Topic_Properties */

/* Create communityforums_Topic_Properties table */
IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'{databaseOwner}[{objectQualifier}communityforums_Topic_Properties]') AND type in (N'U'))
BEGIN
	CREATE TABLE {databaseOwner}[{objectQualifier}communityforums_Topic_Properties](
		[Id] [int] IDENTITY(1,1) NOT NULL,
		[TopicId] [int] NOT NULL,
		[PropertyId] [int] NOT NULL,
		[Value] [nvarchar](max) NULL,
		[DateCreated] [datetime] NOT NULL CONSTRAINT [DF_{objectQualifier}communityforums_Topic_Properties_DateCreated] DEFAULT (GETUTCDATE()),
		[DateUpdated] [datetime] NOT NULL CONSTRAINT [DF_{objectQualifier}communityforums_Topic_Properties_DateUpdated] DEFAULT (GETUTCDATE()),
		CONSTRAINT [PK_{objectQualifier}communityforums_Topic_Properties] PRIMARY KEY CLUSTERED ([Id] ASC)
	)
END
GO

/* Add index on TopicId */
IF NOT EXISTS (SELECT * FROM sys.indexes WHERE object_id = OBJECT_ID(N'{databaseOwner}[{objectQualifier}communityforums_Topic_Properties]') AND name = N'IX_{objectQualifier}communityforums_Topic_Properties_TopicId')
	CREATE INDEX [IX_{objectQualifier}communityforums_Topic_Properties_TopicId] ON {databaseOwner}[{objectQualifier}communityforums_Topic_Properties] ([TopicId] ASC)
GO

/* Add index on PropertyId */
IF NOT EXISTS (SELECT * FROM sys.indexes WHERE object_id = OBJECT_ID(N'{databaseOwner}[{objectQualifier}communityforums_Topic_Properties]') AND name = N'IX_{objectQualifier}communityforums_Topic_Properties_PropertyId')
	CREATE INDEX [IX_{objectQualifier}communityforums_Topic_Properties_PropertyId] ON {databaseOwner}[{objectQualifier}communityforums_Topic_Properties] ([PropertyId] ASC)
GO

/* Add FK to communityforums_Topics with cascade delete */
IF NOT EXISTS (SELECT * FROM sys.foreign_keys WHERE object_id = OBJECT_ID(N'{databaseOwner}[FK_{objectQualifier}communityforums_Topic_Properties_Topics]') AND parent_object_id = OBJECT_ID(N'{databaseOwner}[{objectQualifier}communityforums_Topic_Properties]'))
	ALTER TABLE {databaseOwner}[{objectQualifier}communityforums_Topic_Properties]
		ADD CONSTRAINT [FK_{objectQualifier}communityforums_Topic_Properties_Topics]
		FOREIGN KEY ([TopicId]) REFERENCES {databaseOwner}[{objectQualifier}communityforums_Topics] ([TopicId]) ON DELETE CASCADE
GO

/* Add FK to communityforums_Properties - no cascade delete (cascade delete handled in code on property row delete) */
IF NOT EXISTS (SELECT * FROM sys.foreign_keys WHERE object_id = OBJECT_ID(N'{databaseOwner}[FK_{objectQualifier}communityforums_Topic_Properties_Properties]') AND parent_object_id = OBJECT_ID(N'{databaseOwner}[{objectQualifier}communityforums_Topic_Properties]'))
	ALTER TABLE {databaseOwner}[{objectQualifier}communityforums_Topic_Properties]
		ADD CONSTRAINT [FK_{objectQualifier}communityforums_Topic_Properties_Properties]
		FOREIGN KEY ([PropertyId]) REFERENCES {databaseOwner}[{objectQualifier}communityforums_Properties] ([PropertyId])
GO

/* Migrate existing topic property data from TopicData XML column into communityforums_Topic_Properties */
IF EXISTS (SELECT * FROM sys.columns WHERE object_id = OBJECT_ID(N'{databaseOwner}[{objectQualifier}communityforums_Topics]') AND name = N'TopicData')
BEGIN
	;WITH TopicDataXml AS (
		SELECT
			TopicId,
			TRY_CONVERT(xml, TopicData) AS TopicXml
		FROM {databaseOwner}{objectQualifier}communityforums_Topics
		WHERE ISNULL(TopicData, '') != ''
			AND TRY_CONVERT(xml, TopicData) IS NOT NULL
	)
	INSERT INTO {databaseOwner}[{objectQualifier}communityforums_Topic_Properties] (TopicId, PropertyId, Value, DateCreated, DateUpdated)
	SELECT
		tdx.TopicId,
		prop.value('@id', 'int') AS PropertyId,
		prop.value('(value)[1]', 'nvarchar(max)') AS Value,
		GETUTCDATE(),
		GETUTCDATE()
	FROM TopicDataXml tdx
	CROSS APPLY tdx.TopicXml.nodes('/topicdata/properties/property') AS props(prop)
	WHERE ISNULL(prop.value('(value)[1]', 'nvarchar(max)'), '') != ''
		AND prop.value('@id', 'int') IS NOT NULL
		/* skip rows already migrated to avoid duplicate inserts on re-run */
		AND NOT EXISTS (
			SELECT 1
			FROM {databaseOwner}[{objectQualifier}communityforums_Topic_Properties] tp
			WHERE tp.TopicId = tdx.TopicId
				AND tp.PropertyId = prop.value('@id', 'int')
		)
END
GO

