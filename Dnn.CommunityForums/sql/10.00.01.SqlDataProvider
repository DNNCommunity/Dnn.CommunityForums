   Returns '' AS TopicData for backward compatibility with dependents that read the column */
IF EXISTS (SELECT * FROM sys.views WHERE object_id = OBJECT_ID(N'{databaseOwner}[{objectQualifier}vw_communityforums_Topics]'))
