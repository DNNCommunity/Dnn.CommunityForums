CREATE PROCEDURE {databaseOwner}[{objectQualifier}communityforums_Topics_Delete_For_User]
@ModuleId int,
@UserId int,
@DelBehavior int 
AS

BEGIN

SET NOCOUNT ON

IF @DelBehavior = 1
	BEGIN
		UPDATE t SET t.IsDeleted = 1
		FROM {databaseOwner}[{objectQualifier}communityforums_Topics] t 
		INNER JOIN {databaseOwner}[{objectQualifier}communityforums_Content] c 
		ON c.ContentId = t.ContentId
		WHERE c.AuthorId = @UserId AND c.ModuleId = @ModuleId and c.IsDeleted = 0
		UPDATE r SET r.IsDeleted = 1
		FROM {databaseOwner}[{objectQualifier}communityforums_Replies] r 
		INNER JOIN {databaseOwner}[{objectQualifier}communityforums_Content] c 
		ON c.ContentId = r.ContentId
		WHERE c.AuthorId = @UserId AND c.ModuleId = @ModuleId and c.IsDeleted = 0
		UPDATE c SET c.IsDeleted = 1, c.DateUpdated = GETUTCDATE() 
		FROM {databaseOwner}[{objectQualifier}communityforums_Content] c 
		WHERE c.AuthorId = @UserId AND c.ModuleId = @ModuleId and c.IsDeleted = 0
	END
ELSE
	BEGIN
		DELETE ft
		FROM {databaseOwner}[{objectQualifier}communityforums_ForumTopics] ft
		INNER JOIN {databaseOwner}[{objectQualifier}communityforums_Topics] t 
		ON t.TopicId = ft.TopicId
		INNER JOIN {databaseOwner}[{objectQualifier}communityforums_Content] c 
		ON c.ContentId = t.ContentId
		WHERE c.AuthorId = @UserId AND c.ModuleId = @ModuleId
		DELETE c
		FROM {databaseOwner}[{objectQualifier}communityforums_Content] c 
		WHERE c.AuthorId = @UserId AND c.ModuleId = @ModuleId
	END
END

DECLARE @ForumId INT
		 
BEGIN
	DECLARE forums_cursor CURSOR FOR SELECT ForumId FROM {databaseOwner}[{objectQualifier}communityforums_Forums] WHERE ModuleId = @ModuleId 
	OPEN forums_cursor
		FETCH NEXT FROM forums_cursor into @ForumId
			WHILE (@@fetch_status = 0)
			BEGIN
				EXEC {databaseOwner}[{objectQualifier}communityforums_Forums_LastUpdates] @ForumId
				EXEC {databaseOwner}[{objectQualifier}communityforums_SaveTopicNextPrev] @ForumId
			FETCH NEXT FROM forums_cursor INTO @ForumId
			END
	CLOSE forums_cursor
	DEALLOCATE forums_cursor
END
