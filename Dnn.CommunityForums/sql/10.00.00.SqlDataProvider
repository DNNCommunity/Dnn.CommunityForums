					F.LastTopicId,
					F.LastReplyId,
					IsNull(c.Subject,'') as LastPostSubject,
					IsNull(c.AuthorName,'') as LastPostAuthorName,
					IsNull(c.AuthorId,-1) as LastPostAuthorId,
					IsNull(c.DateCreated,'') as LastPostDate,
					ISNULL(g.PrefixURL,'') as GroupPrefixURL,
