LEFT JOIN {databaseOwner}{objectQualifier}communityforums_Topics as rt on r.topicid = rt.topicId
LEFT JOIN {databaseOwner}{objectQualifier}communityforums_ForumTopics as rft on rt.topicid = rft.topicid
LEFT OUTER JOIN {databaseOwner}{objectQualifier}communityforums_Topics as t on t.contentid = c.contentid and t.isapproved = 1 and t.isdeleted = 0
LEFT JOIN {databaseOwner}{objectQualifier}communityforums_ForumTopics as ft on t.topicid = ft.topicid
LEFT JOIN {databaseOwner}{objectQualifier}communityforums_Forums as af on af.ForumId = ft.ForumId
where c.authorid = @FilteredUserId

		) as posts 
		INNER JOIN string_split(@ForumIds,':') as fids on cast(fids.value as int) = posts.ForumId 
