/* issue 1856 - begin - rename objects */
/* ================================= */

/* rename all objects with activeforums_ prefix to communityforums_ prefix */

SET NOCOUNT ON
DECLARE @databaseOwner sysname = N'{databaseOwner}';
DECLARE @SchemaName sysname = REPLACE(REPLACE(REPLACE(@databaseOwner, '[', '') , ']', '') , '.', '');
DECLARE @OldPrefix  sysname = N'{objectQualifier}activeforums_';
DECLARE @NewPrefix  sysname = N'{objectQualifier}communityforums_';
DECLARE @DryRun     bit     = 0;  -- 1=print only
DECLARE @ErrorCount INT = 0;
DECLARE @SuccessCount INT = 0;
DECLARE @sql NVARCHAR(MAX);
DECLARE @OldPattern sysname = N'%' + @OldPrefix + N'%';
DECLARE @NewPattern sysname = N'%' + @NewPrefix + N'%';

-- ============================================================================
-- PART 1: ANALYSIS - Complete inventory of objects to change
-- ============================================================================

PRINT '=== ANALYSIS PHASE ===';
PRINT '';
PRINT '=== TABLES WITH activeforums_ IN NAME (excluding synonyms) ===';

DECLARE @TableName NVARCHAR(128);

DECLARE tables_cursor CURSOR FOR
SELECT 
    SCHEMA_NAME(o.schema_id),
    o.name
FROM sys.objects o
WHERE name LIKE @OldPattern
AND type = 'U'
AND SCHEMA_NAME(o.schema_id) = @SchemaName
AND type_desc <> 'SYNONYM'

ORDER BY name;

OPEN tables_cursor;
FETCH NEXT FROM tables_cursor INTO @SchemaName, @TableName;

WHILE @@FETCH_STATUS = 0
BEGIN
    PRINT '  ' + @SchemaName + '.' + @TableName;
    FETCH NEXT FROM tables_cursor INTO @SchemaName, @TableName;
END;

CLOSE tables_cursor;
DEALLOCATE tables_cursor;

PRINT '';
PRINT '=== DEPENDENT OBJECTS REFERENCING activeforums_ TABLES ===';

DECLARE @DependentObject NVARCHAR(128);
DECLARE @DependentType NVARCHAR(60);
DECLARE @ReferencedTable NVARCHAR(128);

DECLARE deps_cursor CURSOR FOR
SELECT DISTINCT
    OBJECT_NAME(referencing_id),
    o.type_desc,
    OBJECT_NAME(referenced_id)
FROM sys.sql_expression_dependencies sed
INNER JOIN sys.objects o ON sed.referencing_id = o.object_id
WHERE OBJECT_NAME(referenced_id) LIKE @OldPattern
AND SCHEMA_NAME(o.schema_id) = @SchemaName
AND sed.referencing_id <> sed.referenced_id
AND o.type IN ('V','P','FN','IF','TF','TR')
ORDER BY o.type_desc, OBJECT_NAME(referencing_id);

OPEN deps_cursor;
FETCH NEXT FROM deps_cursor INTO @DependentObject, @DependentType, @ReferencedTable;

WHILE @@FETCH_STATUS = 0
BEGIN
    PRINT '  ' + ISNULL(@DependentObject, 'NULL') + ' (' + @DependentType + ') -> ' + ISNULL(@ReferencedTable, 'NULL');
    FETCH NEXT FROM deps_cursor INTO @DependentObject, @DependentType, @ReferencedTable;
END;

CLOSE deps_cursor;
DEALLOCATE deps_cursor;

PRINT '';
PRINT '=== FOREIGN KEYS REFERENCING activeforums_ TABLES ===';

DECLARE @ParentTable NVARCHAR(128);
DECLARE @ForeignKeyName NVARCHAR(128);

DECLARE fks_cursor CURSOR FOR
SELECT 
    OBJECT_NAME(fk.parent_object_id),
    OBJECT_NAME(fk.referenced_object_id),
    fk.name
FROM sys.foreign_keys fk
WHERE SCHEMA_NAME(fk.schema_id) = @SchemaName
AND (OBJECT_NAME(fk.referenced_object_id) LIKE @OldPattern OR OBJECT_NAME(fk.parent_object_id) LIKE @OldPattern)
ORDER BY OBJECT_NAME(fk.parent_object_id), OBJECT_NAME(fk.referenced_object_id);

OPEN fks_cursor;
FETCH NEXT FROM fks_cursor INTO @ParentTable, @ReferencedTable, @ForeignKeyName;

WHILE @@FETCH_STATUS = 0
BEGIN
    PRINT '  ' + ISNULL(@ParentTable, 'NULL') + ' -> ' + ISNULL(@ReferencedTable, 'NULL') + ' (FK: ' + @ForeignKeyName + ')';
    FETCH NEXT FROM fks_cursor INTO @ParentTable, @ReferencedTable, @ForeignKeyName;
END;

CLOSE fks_cursor;
DEALLOCATE fks_cursor;

PRINT '';
PRINT '=== EXISTING SYNONYMS WITH activeforums_ ===';

DECLARE @SynonymName NVARCHAR(128);
DECLARE @TargetObject NVARCHAR(776);

DECLARE syns_cursor CURSOR FOR
SELECT 
    SCHEMA_NAME(s.schema_id),
    s.name,
    s.base_object_name
FROM sys.synonyms s
WHERE name LIKE '%activeforums_%'
AND SCHEMA_NAME(s.schema_id) = @SchemaName
ORDER BY name;

OPEN syns_cursor;
FETCH NEXT FROM syns_cursor INTO @SchemaName, @SynonymName, @TargetObject;

WHILE @@FETCH_STATUS = 0
BEGIN
    PRINT '  ' + @SchemaName + '.' + @SynonymName + ' -> ' + ISNULL(@TargetObject, 'NULL');
    FETCH NEXT FROM syns_cursor INTO @SchemaName, @SynonymName, @TargetObject;
END;

CLOSE syns_cursor;
DEALLOCATE syns_cursor;

-- ============================================================================
-- PART 2: MIGRATION - renaming with comprehensive updates
-- ============================================================================

PRINT '';
PRINT '=== MIGRATION PHASE ===';
PRINT '';
BEGIN TRY

    -- Tracking tables
    IF OBJECT_ID('tempdb..#RenameLog') IS NOT NULL DROP TABLE #RenameLog;
    CREATE TABLE #RenameLog (
        old_name NVARCHAR(128),
        new_name NVARCHAR(128),
        object_type NVARCHAR(60),
        schema_name NVARCHAR(128),
        status NVARCHAR(50)
    );
    
    IF OBJECT_ID('tempdb..#RenamedObjects') IS NOT NULL DROP TABLE #RenamedObjects;
    CREATE TABLE #RenamedObjects (
        old_name NVARCHAR(128),
        new_name NVARCHAR(128),
        object_type NVARCHAR(60),
        schema_name NVARCHAR(128)
    );

    -- ========================================================================
    -- Step 1: Disable foreign keys referencing tables to be renamed
    -- ========================================================================
    PRINT '';
    PRINT 'Step 1: Disabling foreign keys...';
    
    DECLARE @fk_name NVARCHAR(128);
    DECLARE @parent_table NVARCHAR(128);
    
    IF CURSOR_STATUS('global', 'fk_cursor') >= 0 CLOSE fk_cursor;
    IF CURSOR_STATUS('global', 'fk_cursor') >= -1 DEALLOCATE fk_cursor;
    DECLARE fk_cursor CURSOR FOR
    SELECT fk.name, OBJECT_NAME(fk.parent_object_id)
    FROM sys.foreign_keys fk
    WHERE SCHEMA_NAME(fk.schema_id) = @SchemaName
    AND (OBJECT_NAME(fk.referenced_object_id) LIKE @OldPattern OR OBJECT_NAME(fk.parent_object_id) LIKE @OldPattern)

    OPEN fk_cursor;
    FETCH NEXT FROM fk_cursor INTO @fk_name, @parent_table;

    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @sql = 'ALTER TABLE ' + @parent_table + ' NOCHECK CONSTRAINT ' + @fk_name;
        BEGIN TRY
            PRINT '  Disabling FK: ' + @fk_name;
            IF @DryRun = 1
                PRINT @sql;
            ELSE
                EXEC sys.sp_executesql @sql;
        END TRY
        BEGIN CATCH
            PRINT '  WARNING: Could not disable FK ' + @fk_name + ' - ' + ERROR_MESSAGE();
        END CATCH;
        FETCH NEXT FROM fk_cursor INTO @fk_name, @parent_table;
    END;
    CLOSE fk_cursor;
    DEALLOCATE fk_cursor;

    -- ========================================================================
    -- Step 2: Drop and recreate foreign keys
    -- ========================================================================
    PRINT '';
    PRINT 'Step 2: Backing up foreign key definitions...';
    
    IF OBJECT_ID('tempdb..#ForeignKeyDefinitions') IS NOT NULL DROP TABLE #ForeignKeyDefinitions;
    CREATE TABLE #ForeignKeyDefinitions (
        fk_name NVARCHAR(128),
        parent_table NVARCHAR(128),
        referenced_table NVARCHAR(128),
        fk_definition NVARCHAR(MAX)
    );

    INSERT INTO #ForeignKeyDefinitions
    SELECT 
        fk.name,
        OBJECT_NAME(fk.parent_object_id),
        OBJECT_NAME(fk.referenced_object_id),
        'ALTER TABLE ' + OBJECT_NAME(fk.parent_object_id) + 
        ' ADD CONSTRAINT ' + fk.name + 
        ' FOREIGN KEY (' + (
            SELECT STRING_AGG(COL_NAME(fkc.parent_object_id, fkc.parent_column_id), ',')
            FROM sys.foreign_key_columns fkc
            WHERE fkc.constraint_object_id = fk.object_id
        ) + ') REFERENCES ' + OBJECT_NAME(fk.referenced_object_id) + 
        ' (' + (
            SELECT STRING_AGG(COL_NAME(fkc.referenced_object_id, fkc.referenced_column_id), ',')
            FROM sys.foreign_key_columns fkc
            WHERE fkc.constraint_object_id = fk.object_id
        ) + ')'
    FROM sys.foreign_keys fk    
    WHERE SCHEMA_NAME(fk.schema_id) = @SchemaName
    AND (OBJECT_NAME(fk.referenced_object_id) LIKE @OldPattern OR OBJECT_NAME(fk.parent_object_id) LIKE @OldPattern)

    -- Drop foreign keys
    IF CURSOR_STATUS('global', 'fk_drop_cursor') >= 0 CLOSE fk_drop_cursor;
    IF CURSOR_STATUS('global', 'fk_drop_cursor') >= -1 DEALLOCATE fk_drop_cursor;    
    DECLARE fk_drop_cursor CURSOR FOR
    SELECT fk_name FROM #ForeignKeyDefinitions;
    
    OPEN fk_drop_cursor;
    FETCH NEXT FROM fk_drop_cursor INTO @fk_name;

    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @sql = 'ALTER TABLE ' + (
            SELECT parent_table FROM #ForeignKeyDefinitions WHERE fk_name = @fk_name
        ) + ' DROP CONSTRAINT ' + @fk_name;
        BEGIN TRY
            PRINT '  Dropping FK: ' + @fk_name;
            IF @DryRun = 1
                PRINT @sql;
            ELSE
                EXEC sp_executesql @sql;
        END TRY
        BEGIN CATCH
            PRINT '  WARNING: Could not drop FK ' + @fk_name;
        END CATCH;
        FETCH NEXT FROM fk_drop_cursor INTO @fk_name;
    END;
    CLOSE fk_drop_cursor;
    DEALLOCATE fk_drop_cursor;

    -- ========================================================================
    -- Step 3: Rename tables (only if new name doesn't already exist)
    -- ========================================================================
    PRINT '';
    PRINT 'Step 3: Renaming tables...';
    
    DECLARE @old_name NVARCHAR(128);
    DECLARE @new_name NVARCHAR(128);
    
    IF CURSOR_STATUS('global', 'table_cursor') >= 0 CLOSE table_cursor;
    IF CURSOR_STATUS('global', 'table_cursor') >= -1 DEALLOCATE table_cursor;
    DECLARE table_cursor CURSOR FOR
    SELECT 
        o.name,
        REPLACE(o.name, @OldPrefix, @NewPrefix),
        SCHEMA_NAME(o.schema_id)
    FROM sys.objects o    
    WHERE o.name LIKE @OldPattern
    AND o.type = 'U'
    AND SCHEMA_NAME(o.schema_id) = @SchemaName
    AND (OBJECTPROPERTY(object_id, 'IsSynonym') = 0 OR OBJECTPROPERTY(object_id, 'IsSynonym') IS NULL)
    AND NOT EXISTS (
        SELECT 1 FROM sys.objects o2
        WHERE o2.name = REPLACE(o.name, @OldPrefix, @NewPrefix)
        AND o2.schema_id = o.schema_id
    );

    OPEN table_cursor;
    FETCH NEXT FROM table_cursor INTO @old_name, @new_name, @SchemaName;

    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @sql = 'EXEC sp_rename ''' + @SchemaName + '.' + @old_name + ''', ''' + @new_name + ''';';
        BEGIN TRY
            PRINT '  Renamed table: ' + @old_name + ' -> ' + @new_name;
            
            IF @DryRun = 1
                PRINT @sql;
            ELSE
                EXEC sys.sp_executesql @sql;

            INSERT INTO #RenameLog VALUES (@old_name, @new_name, 'TABLE', @SchemaName, 'RENAMED');
            INSERT INTO #RenamedObjects VALUES (@old_name, @new_name, 'TABLE', @SchemaName);
            SET @SuccessCount = @SuccessCount + 1;
        END TRY
        BEGIN CATCH
            INSERT INTO #RenameLog VALUES (@old_name, @new_name, 'TABLE', @SchemaName, 'FAILED');
            PRINT '  ERROR: Could not rename table ' + @old_name + ' - ' + ERROR_MESSAGE();
            SET @ErrorCount = @ErrorCount + 1;
        END CATCH;
        
        FETCH NEXT FROM table_cursor INTO @old_name, @new_name, @SchemaName;
    END;
    CLOSE table_cursor;
    DEALLOCATE table_cursor;

    -- ========================================================================
    -- Step 4: Renaming constraints...
    -- ========================================================================
    PRINT '';
    PRINT 'Step 4: Renaming constraints...';

    IF OBJECT_ID('tempdb..#Constraints') IS NOT NULL
        DROP TABLE #Constraints;

    CREATE TABLE #Constraints
    (
        object_name     sysname,
        new_name        sysname,
        object_type     varchar(20),
        parent_table    sysname,
        schema_name     sysname
    );

    -- PK/UQ
    INSERT INTO #Constraints
    SELECT
        kc.name,
        REPLACE(kc.name,@OldPrefix,@NewPrefix),
        kc.type,
        OBJECT_NAME(kc.parent_object_id),
        SCHEMA_NAME(o.schema_id)
    FROM sys.key_constraints kc
    JOIN sys.objects o
        ON o.object_id = kc.parent_object_id
    WHERE SCHEMA_NAME(o.schema_id) = @SchemaName
    AND kc.name LIKE @OldPattern;

    -- CHECK constraints
    INSERT INTO #Constraints
    SELECT
        cc.name,
        REPLACE(cc.name,@OldPrefix,@NewPrefix),
        'CK',
        OBJECT_NAME(cc.parent_object_id),
        SCHEMA_NAME(o.schema_id)
    FROM sys.check_constraints cc
    JOIN sys.objects o
        ON o.object_id = cc.parent_object_id
    WHERE SCHEMA_NAME(o.schema_id) = @SchemaName
    AND cc.name LIKE @OldPattern;

    -- DEFAULT constraints
    INSERT INTO #Constraints
    SELECT
        dc.name,
        REPLACE(dc.name,@OldPrefix,@NewPrefix),
        'DF',
        OBJECT_NAME(dc.parent_object_id),
        SCHEMA_NAME(o.schema_id)
    FROM sys.default_constraints dc
    JOIN sys.objects o
        ON o.object_id = dc.parent_object_id
    WHERE SCHEMA_NAME(o.schema_id) = @SchemaName
    AND dc.name LIKE @OldPattern;

    DECLARE @ConstraintName sysname,
            @NewConstraintName sysname,
            @ConstraintType varchar(20);

    IF CURSOR_STATUS('global', 'constraint_cursor') >= 0 CLOSE constraint_cursor;
    IF CURSOR_STATUS('global', 'constraint_cursor') >= -1 DEALLOCATE constraint_cursor;

    DECLARE constraint_cursor CURSOR FOR
    SELECT
        object_name,
        new_name,
        object_type
    FROM #Constraints
    WHERE object_name <> new_name;

    OPEN constraint_cursor;
    FETCH NEXT FROM constraint_cursor INTO @ConstraintName, @NewConstraintName, @ConstraintType;

    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @sql = 'EXEC sp_rename N''' + @ConstraintName + ''', N''' + @NewConstraintName + ''', ''OBJECT'';';

        BEGIN TRY
            PRINT '  Renamed ' + @ConstraintType + ': ' + @ConstraintName + ' -> ' + @NewConstraintName;

            IF @DryRun = 1
                PRINT @sql;
            ELSE
                EXEC sys.sp_executesql @sql;
        END TRY
        BEGIN CATCH
            PRINT '  WARNING: Could not rename constraint ' + @ConstraintName + ' - ' + ERROR_MESSAGE();
        END CATCH;

        FETCH NEXT FROM constraint_cursor INTO @ConstraintName, @NewConstraintName, @ConstraintType;
    END

    CLOSE constraint_cursor;
    DEALLOCATE constraint_cursor;
    
    -- ========================================================================
    -- Step 5: rename indexes
    -- ========================================================================
    PRINT '';
    PRINT 'Step 5: Renaming indexes...';

    IF OBJECT_ID('tempdb..#Indexes') IS NOT NULL
        DROP TABLE #Indexes;

    CREATE TABLE #Indexes
    (
        table_name  sysname,
        index_name  sysname,
        new_name    sysname,
        schema_name sysname
    );

    INSERT INTO #Indexes
    SELECT
        OBJECT_NAME(i.object_id),
        i.name,
        REPLACE(i.name,@OldPrefix,@NewPrefix),
        SCHEMA_NAME(o.schema_id)
    FROM sys.indexes i
    JOIN sys.objects o
        ON i.object_id = o.object_id
    WHERE i.name IS NOT NULL
    AND SCHEMA_NAME(o.schema_id) = @SchemaName
    AND i.is_hypothetical = 0
    AND i.name LIKE @OldPattern;

    DECLARE @IndexName sysname,
            @NewIndexName sysname,
            @IndexTable sysname;
    
    IF CURSOR_STATUS('global', 'index_cursor') >= 0 CLOSE index_cursor;
    IF CURSOR_STATUS('global', 'index_cursor') >= -1 DEALLOCATE index_cursor;
    DECLARE index_cursor CURSOR FOR
    SELECT
        table_name,
        index_name,
        new_name
    FROM #Indexes
    WHERE index_name <> new_name;

    OPEN index_cursor;
    FETCH NEXT FROM index_cursor INTO @IndexTable, @IndexName, @NewIndexName;

    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @sql = 'EXEC sp_rename N''' + QUOTENAME(@SchemaName) + '.' + QUOTENAME(@IndexTable) + '.' + QUOTENAME(@IndexName) + ''', N''' + @NewIndexName + ''', ''INDEX'';';

        BEGIN TRY
            PRINT '  Renamed INDEX: ' + @IndexName + ' -> ' + @NewIndexName;

            IF @DryRun = 1
                PRINT @sql;
            ELSE
                EXEC sys.sp_executesql @sql;
        END TRY
        BEGIN CATCH
            PRINT '  WARNING: Could not rename index ' + @IndexName + ' - ' + ERROR_MESSAGE();
        END CATCH;

        FETCH NEXT FROM index_cursor INTO @IndexTable, @IndexName, @NewIndexName;
    END

    CLOSE index_cursor;
    DEALLOCATE index_cursor;

    -- ========================================================================
    -- Step 6: Update foreign key definitions and recreate them
    -- ========================================================================
    PRINT '';
    PRINT 'Step 6: Recreating foreign keys with updated names...';
    
    DECLARE @fk_definition NVARCHAR(MAX);

    IF CURSOR_STATUS('global', 'fk_recreate_cursor') >= 0 CLOSE fk_recreate_cursor;
    IF CURSOR_STATUS('global', 'fk_recreate_cursor') >= -1 DEALLOCATE fk_recreate_cursor;
    DECLARE fk_recreate_cursor CURSOR FOR
    SELECT fk_name, fk_definition FROM #ForeignKeyDefinitions;

    OPEN fk_recreate_cursor;
    FETCH NEXT FROM fk_recreate_cursor INTO @fk_name, @fk_definition;

    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @fk_name = REPLACE(@fk_name, @OldPrefix, @NewPrefix);
        SET @fk_definition = REPLACE(@fk_definition, @OldPrefix, @NewPrefix);
        
        BEGIN TRY
            PRINT '  Recreated FK: ' + @fk_name;
            
            IF @DryRun = 1
                PRINT @fk_definition;
            ELSE
                EXEC sys.sp_executesql @fk_definition;

            SET @SuccessCount = @SuccessCount + 1;
        END TRY
        BEGIN CATCH
            PRINT '  WARNING: Could not recreate FK - ' + ERROR_MESSAGE();
            SET @ErrorCount = @ErrorCount + 1;
        END CATCH;
        
        FETCH NEXT FROM fk_recreate_cursor INTO @fk_name, @fk_definition;
    END;
    CLOSE fk_recreate_cursor;
    DEALLOCATE fk_recreate_cursor;

    -- ========================================================================
    -- Step 7: Update views, procedures, functions, triggers
    -- ========================================================================
    PRINT '';
    PRINT 'Step 7: Updating views, procedures, and functions...';
     
    DECLARE @Targets TABLE
    (
      ObjKey bigint IDENTITY(1,1) PRIMARY KEY,
      ObjectId int NOT NULL,
      ObjectType nvarchar(60) NOT NULL,
      SchemaName sysname NOT NULL,
      OldName sysname NOT NULL,
      NewName sysname NOT NULL,
      CreateSQL nvarchar(max) NULL,
      DependedOnCount int NULL,
      CreateSQLRewritten nvarchar(max) NULL,
      Created bit NOT NULL DEFAULT 0
    );

    -- Capture targets (views + procs + functions) and their definitions BEFORE drops
    ;WITH P AS
    (
      SELECT
        o.object_id,
        TypeDesc =
          CASE 
            WHEN o.type = 'V' THEN 'VIEW'
            WHEN o.type = 'P' THEN 'PROCEDURE'
            WHEN o.type IN ('FN','TF','FS','FT') THEN 'FUNCTION'
            ELSE NULL
          END,
        SchemaName = s.name,
        OldName = o.name
      FROM sys.objects o
      JOIN sys.schemas s ON s.schema_id = o.schema_id
      WHERE s.name = @SchemaName
        AND o.type IN ('V','P','FN','TF','FS','FT')
        AND o.name LIKE @OldPattern
        AND REPLACE(o.name,@OldPrefix,@NewPrefix) <> o.name
    )
    INSERT INTO @Targets (ObjectId, ObjectType, SchemaName, OldName, NewName, CreateSQL)
    SELECT
      p.object_id,
      p.TypeDesc,
      p.SchemaName,
      p.OldName,
      REPLACE(p.OldName,@OldPrefix,@NewPrefix) AS NewName,
      m.definition
    FROM P p
    LEFT JOIN sys.sql_modules m ON m.object_id = p.object_id;
 
    UPDATE t
    SET CreateSQLRewritten = REPLACE(COALESCE(t.CreateSQL,N''), @OldPrefix, @NewPrefix) + CHAR(10)
    FROM @Targets t;

    -- Dependency order
    ;WITH Traverse AS
    (
        SELECT
            t.ObjectId AS StartObjectId,
            t.ObjectId AS CurrentObjectId,
            CAST('|' + CAST(t.ObjectId AS varchar(20)) + '|' AS varchar(max)) AS Path
        FROM @Targets t

        UNION ALL

        SELECT
            t.StartObjectId,
            d.referenced_id,
            t.Path + CAST(d.referenced_id AS varchar(20)) + '|'
        FROM Traverse t
        JOIN sys.sql_expression_dependencies d
            ON d.referencing_id = t.CurrentObjectId
            AND d.referenced_id IN (SELECT ObjectId FROM @Targets)
        WHERE d.referenced_id IS NOT NULL
          AND t.Path NOT LIKE '%|' + CAST(d.referenced_id AS varchar(20)) + '|%'
    ),
    DependencyCounts AS
    (
        SELECT
            StartObjectId,
            COUNT(DISTINCT CurrentObjectId) - 1 AS RecursiveDistinctDependencyCount
        FROM Traverse
        GROUP BY StartObjectId
    )
    UPDATE t
    SET DependedOnCount = ISNULL(dc.RecursiveDistinctDependencyCount, 0)
    FROM @Targets t
    LEFT JOIN DependencyCounts dc ON dc.StartObjectId = t.ObjectId
    OPTION (MAXRECURSION 100);

    -- Output targets info to Messages
    PRINT '';
    PRINT '  Target Objects to Process:';
    DECLARE @TargetOldName sysname, @TargetNewName sysname, @TargetType nvarchar(60), @TargetDepCount int;
    DECLARE targets_info_cursor CURSOR FOR
    SELECT OldName, NewName, ObjectType, DependedOnCount FROM @Targets ORDER BY ObjKey;
    
    OPEN targets_info_cursor;
    FETCH NEXT FROM targets_info_cursor INTO @TargetOldName, @TargetNewName, @TargetType, @TargetDepCount;
    
    WHILE @@FETCH_STATUS = 0
    BEGIN
        PRINT '    ' + @TargetType + ': ' + @TargetOldName + ' -> ' + @TargetNewName + ' (Dependencies: ' + CAST(ISNULL(@TargetDepCount, 0) AS VARCHAR(10)) + ')';
        FETCH NEXT FROM targets_info_cursor INTO @TargetOldName, @TargetNewName, @TargetType, @TargetDepCount;
    END;
    
    CLOSE targets_info_cursor;
    DEALLOCATE targets_info_cursor;

    -- Drop programmable targets
    DECLARE @DropSql nvarchar(max) = N'';

    SELECT @DropSql = @DropSql +
      CASE t.ObjectType
        WHEN 'VIEW' THEN N'DROP VIEW ' + QUOTENAME(t.SchemaName) + N'.' + QUOTENAME(t.OldName) + N';' + CHAR(10)
        WHEN 'PROCEDURE' THEN N'DROP PROCEDURE ' + QUOTENAME(t.SchemaName) + N'.' + QUOTENAME(t.OldName) + N';' + CHAR(10)
        WHEN 'FUNCTION' THEN N'DROP FUNCTION ' + QUOTENAME(t.SchemaName) + N'.' + QUOTENAME(t.OldName) + N';' + CHAR(10)
      END
    FROM @Targets t;
    
    BEGIN TRY
        PRINT '  Dropping programmable objects';            
        
        IF @DryRun = 1
            PRINT @DropSql;
        ELSE
            EXEC sys.sp_executesql @DropSql;

        SET @SuccessCount = @SuccessCount + 1;
    END TRY
    BEGIN CATCH
        PRINT '  WARNING: Could not drop programmable objects - ' + ERROR_MESSAGE();
        SET @ErrorCount = @ErrorCount + 1;
    END CATCH;

    -- Iteratively recreate in dependency order
    PRINT '  Creating programmable objects.';

    DECLARE @ObjectName sysname;
    DECLARE @ObjectId int;
    DECLARE @CreateSql nvarchar(max) = N'';

    DECLARE @CreatedThisPass int = 1;
    WHILE @CreatedThisPass > 0
    BEGIN
        SELECT @CreatedThisPass = COUNT(*) FROM @Targets t WHERE t.Created = 0;

        IF @CreatedThisPass = 0 BREAK;

        BEGIN TRY
            SELECT TOP 1 @CreateSql = t.CreateSQLRewritten + CHAR(10) + N';' + CHAR(10), @ObjectId = t.ObjectId, @ObjectName = t.NewName 
            FROM @Targets t
            WHERE t.Created = 0
            ORDER BY t.DependedOnCount;
            
            PRINT '  Creating: ' + @ObjectName;
            IF @DryRun = 1
                PRINT @CreateSql;
            ELSE
                EXEC sys.sp_executesql @CreateSql;

            -- Mark as created
            UPDATE t SET Created = 1 FROM @Targets t WHERE t.ObjectId = @ObjectId;

            -- Decrement dependency counts for objects that reference the newly created one
            ;WITH Traverse AS
            (
                SELECT
                    @ObjectId AS ObjectId,
                    CAST('|' + CAST(@ObjectId AS varchar(20)) + '|' AS varchar(max)) AS Path

                UNION ALL

                SELECT
                    d.referencing_id,
                    t.Path + CAST(d.referencing_id AS varchar(20)) + '|'
                FROM Traverse t
                JOIN sys.sql_expression_dependencies d
                    ON d.referenced_id = t.ObjectId
                WHERE d.referencing_id IS NOT NULL
                  AND d.referencing_id IN (SELECT ObjectId FROM @Targets)
                  AND t.Path NOT LIKE '%|' + CAST(d.referencing_id AS varchar(20)) + '|%'
            ),
            Deps AS
            (
                SELECT DISTINCT ObjectId FROM Traverse WHERE ObjectId <> @ObjectId
            )
            UPDATE t
            SET DependedOnCount = t.DependedOnCount - 1
            FROM @Targets t
            JOIN Deps d ON d.ObjectId = t.ObjectId
            OPTION (MAXRECURSION 100);

            INSERT INTO #RenameLog SELECT t.OldName, t.NewName, t.ObjectType, @SchemaName, 'RENAMED' FROM @Targets t WHERE t.ObjectId = @ObjectId;
            INSERT INTO #RenamedObjects SELECT t.OldName, t.NewName, t.ObjectType, @SchemaName FROM @Targets t WHERE t.ObjectId = @ObjectId;

            SET @SuccessCount = @SuccessCount + 1;
        END TRY
        BEGIN CATCH
            PRINT '  WARNING: Could not create programmable object - ' + ERROR_MESSAGE();
            SET @ErrorCount = @ErrorCount + 1;
            
            -- Mark as created anyway to avoid infinite loop
            UPDATE t SET Created = 1 FROM @Targets t WHERE t.ObjectId = @ObjectId;
        END CATCH;
    END

    -- Final forced create for anything left (cycles/unresolved references or dependency detection limitations)
    DECLARE @Remaining int = (SELECT COUNT(*) FROM @Targets WHERE Created = 0);
    WHILE @Remaining > 0
    BEGIN
        DECLARE @ForceSql nvarchar(max) = N'';

        SELECT TOP 1 @ForceSql = t.CreateSQLRewritten + N';' + CHAR(10), @ObjectId = t.ObjectId, @ObjectName = t.NewName 
        FROM @Targets t
        WHERE t.Created = 0;

        PRINT '  Creating (Forced): ' + @ObjectName;
        
        BEGIN TRY
            IF @DryRun = 1
                PRINT @ForceSql;
            ELSE
                EXEC sys.sp_executesql @ForceSql;
        END TRY
        BEGIN CATCH
            PRINT '  ERROR: Could not create ' + @ObjectName + ' - ' + ERROR_MESSAGE();
        END CATCH;
        
        -- Mark as created
        UPDATE t SET Created = 1 FROM @Targets t WHERE t.Created = 0 AND t.ObjectId = @ObjectId;

        SET @Remaining = (SELECT COUNT(*) FROM @Targets WHERE Created = 0);
    END

    -- ========================================================================
    -- Step 8: Re-enable foreign keys
    -- ========================================================================
    PRINT '';
    PRINT 'Step 8: Re-enabling foreign keys...';
    
    IF CURSOR_STATUS('global', 'fk_enable_cursor') >= 0 CLOSE fk_enable_cursor;
    IF CURSOR_STATUS('global', 'fk_enable_cursor') >= -1 DEALLOCATE fk_enable_cursor;
    DECLARE fk_enable_cursor CURSOR FOR
    SELECT fk.name, OBJECT_NAME(fk.parent_object_id)
    FROM sys.foreign_keys fk    
    WHERE SCHEMA_NAME(fk.schema_id) = @SchemaName
    AND (OBJECT_NAME(fk.referenced_object_id) LIKE @NewPattern OR OBJECT_NAME(fk.parent_object_id) LIKE @NewPattern)

    OPEN fk_enable_cursor;
    FETCH NEXT FROM fk_enable_cursor INTO @fk_name, @parent_table;

    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @sql = 'ALTER TABLE ' + @parent_table + ' CHECK CONSTRAINT ' + @fk_name;
        BEGIN TRY
            IF @DryRun = 1
                PRINT @sql;
            ELSE
                EXEC sp_executesql @sql;

            PRINT '  Enabled FK: ' + @fk_name;
        END TRY
        BEGIN CATCH
            PRINT '  WARNING: Could not enable FK ' + @fk_name;
        END CATCH;
        FETCH NEXT FROM fk_enable_cursor INTO @fk_name, @parent_table;
    END;
    CLOSE fk_enable_cursor;
    DEALLOCATE fk_enable_cursor;

    -- ========================================================================
    -- Step 9: Drop existing activeforums_ synonyms (will recreate them)
    -- ========================================================================

	IF ((SELECT COUNT(*) FROM #RenamedObjects) > 0)
    BEGIN
        PRINT '';
        PRINT 'Step 9: Preparing synonym recreation...';
    
        IF CURSOR_STATUS('global', 'synonym_cursor') >= 0 CLOSE synonym_cursor;
        IF CURSOR_STATUS('global', 'synonym_cursor') >= -1 DEALLOCATE synonym_cursor;
        DECLARE synonym_cursor CURSOR FOR
        SELECT 
            name,
            SCHEMA_NAME(schema_id)
        FROM sys.synonyms
        WHERE name LIKE @OldPattern;

        OPEN synonym_cursor;
        FETCH NEXT FROM synonym_cursor INTO @old_name, @SchemaName;

        WHILE @@FETCH_STATUS = 0
        BEGIN
            SET @sql = 'DROP SYNONYM ' + @SchemaName + '.' + @old_name;
            BEGIN TRY
                PRINT '  Dropped old synonym: ' + @old_name;
                IF @DryRun = 1
                    PRINT @sql;
                ELSE
                    EXEC sys.sp_executesql @sql;
            END TRY
            BEGIN CATCH
                PRINT '  WARNING: Could not drop synonym ' + @old_name;
            END CATCH;
            FETCH NEXT FROM synonym_cursor INTO @old_name, @SchemaName;
        END;
        CLOSE synonym_cursor;
        DEALLOCATE synonym_cursor;
    END

    -- ========================================================================
    -- Step 10: Create synonyms for all renamed objects
    -- ========================================================================
	IF ((SELECT COUNT(*) FROM #RenamedObjects) > 0)
    BEGIN
        PRINT '';
        PRINT 'Step 10: Creating backward-compatibility synonyms...';
    
        DECLARE @dependent_type NVARCHAR(60);

        IF CURSOR_STATUS('global', 'syn_cursor') >= 0 CLOSE syn_cursor;
        IF CURSOR_STATUS('global', 'syn_cursor') >= -1 DEALLOCATE syn_cursor;
        DECLARE syn_cursor CURSOR FOR
        SELECT old_name, new_name, schema_name, object_type
        FROM #RenamedObjects
        ORDER BY old_name;
    
        OPEN syn_cursor;
        FETCH NEXT FROM syn_cursor INTO @old_name, @new_name, @SchemaName, @dependent_type;

        WHILE @@FETCH_STATUS = 0
        BEGIN
            SET @sql = 'CREATE SYNONYM ' + @SchemaName + '.' + @old_name + 
                       ' FOR ' + @SchemaName + '.' + @new_name;
            BEGIN TRY
                PRINT '  Created synonym: ' + @old_name + ' -> ' + @new_name;
                IF @DryRun = 1
                    PRINT @sql;
                ELSE
                    EXEC sys.sp_executesql @sql;
            
                SET @SuccessCount = @SuccessCount + 1;
            END TRY
            BEGIN CATCH
                PRINT '  WARNING: Could not create synonym ' + @old_name + ' - ' + ERROR_MESSAGE();
                SET @ErrorCount = @ErrorCount + 1;
            END CATCH;
        
            FETCH NEXT FROM syn_cursor INTO @old_name, @new_name, @SchemaName, @dependent_type;
        END;
        CLOSE syn_cursor;
        DEALLOCATE syn_cursor;
    END

    -- ========================================================================
    -- VERIFICATION
    -- ========================================================================
    PRINT '';
    PRINT '===== MIGRATION SUMMARY =====';
    PRINT 'Objects successfully processed: ' + CAST(@SuccessCount AS VARCHAR(10));
    PRINT 'Errors encountered: ' + CAST(@ErrorCount AS VARCHAR(10));
    
    PRINT '';
    PRINT 'Remaining activeforums_ objects (excluding synonyms - should be empty):';
    
    DECLARE @ObjectName2 NVARCHAR(128);
    DECLARE @ObjectType2 NVARCHAR(60);

    DECLARE remaining_cursor CURSOR FOR
    SELECT 
        SCHEMA_NAME(schema_id),
        name,
        type_desc
    FROM sys.objects
    WHERE name LIKE @OldPattern
    AND SCHEMA_NAME(schema_id) = @SchemaName
    AND type_desc <> 'SYNONYM'
    ORDER BY type_desc, name;
    
    OPEN remaining_cursor;
    FETCH NEXT FROM remaining_cursor INTO @SchemaName, @ObjectName2, @ObjectType2;
    
    IF @@FETCH_STATUS <> 0
        PRINT '  (None - migration successful!)';
    
    WHILE @@FETCH_STATUS = 0
    BEGIN
        PRINT '  ' + @SchemaName + '.' + @ObjectName2 + ' (' + @ObjectType2 + ')';
        FETCH NEXT FROM remaining_cursor INTO @SchemaName, @ObjectName2, @ObjectType2;
    END;
    
    CLOSE remaining_cursor;
    DEALLOCATE remaining_cursor;

    PRINT '';
    PRINT 'New ' + @newPrefix + ' objects created:';
    
    DECLARE new_objs_cursor CURSOR FOR
    SELECT 
        SCHEMA_NAME(schema_id),
        name,
        type_desc
    FROM sys.objects
    WHERE name LIKE @NewPattern
    AND SCHEMA_NAME(schema_id) = @SchemaName
    AND type_desc <> 'SYNONYM'

    ORDER BY type_desc, name;
    
    OPEN new_objs_cursor;
    FETCH NEXT FROM new_objs_cursor INTO @SchemaName, @ObjectName2, @ObjectType2;
    
    WHILE @@FETCH_STATUS = 0
    BEGIN
        PRINT '  ' + @SchemaName + '.' + @ObjectName2 + ' (' + @ObjectType2 + ')';
        FETCH NEXT FROM new_objs_cursor INTO @SchemaName, @ObjectName2, @ObjectType2;
    END;
    
    CLOSE new_objs_cursor;
    DEALLOCATE new_objs_cursor;

    PRINT '';
    PRINT 'Backward-compatibility synonyms created:';
    
    DECLARE syns_final_cursor CURSOR FOR
    SELECT 
        SCHEMA_NAME(schema_id),
        name,
        base_object_name
    FROM sys.synonyms
    WHERE name LIKE @OldPattern
    AND SCHEMA_NAME(schema_id) = @SchemaName
    ORDER BY name;
    
    OPEN syns_final_cursor;
    FETCH NEXT FROM syns_final_cursor INTO @SchemaName, @SynonymName, @TargetObject;
    
    WHILE @@FETCH_STATUS = 0
    BEGIN
        PRINT '  ' + @SchemaName + '.' + @SynonymName + ' -> ' + ISNULL(@TargetObject, 'NULL');
        FETCH NEXT FROM syns_final_cursor INTO @SchemaName, @SynonymName, @TargetObject;
    END;
    
    CLOSE syns_final_cursor;
    DEALLOCATE syns_final_cursor;

    -- Cleanup
    DROP TABLE #RenamedObjects;
    DROP TABLE #RenameLog;
    DROP TABLE #ForeignKeyDefinitions;
    DROP TABLE #Indexes;
    DROP TABLE #Constraints;

    
    PRINT '';
    PRINT '=== MIGRATION COMPLETE ===';

END TRY
BEGIN CATCH
    PRINT 'CRITICAL ERROR: ' + ERROR_MESSAGE();
    
    -- Close any open cursors
    IF CURSOR_STATUS('global', 'tables_cursor') >= 0 BEGIN CLOSE tables_cursor; DEALLOCATE tables_cursor; END;
    IF CURSOR_STATUS('global', 'deps_cursor') >= 0 BEGIN CLOSE deps_cursor; DEALLOCATE deps_cursor; END;
    IF CURSOR_STATUS('global', 'fks_cursor') >= 0 BEGIN CLOSE fks_cursor; DEALLOCATE fks_cursor; END;
    IF CURSOR_STATUS('global', 'syns_cursor') >= 0 BEGIN CLOSE syns_cursor; DEALLOCATE syns_cursor; END;
    IF CURSOR_STATUS('global', 'table_cursor') >= 0 BEGIN CLOSE table_cursor; DEALLOCATE table_cursor; END;
    IF CURSOR_STATUS('global', 'constraint_cursor') >= 0 BEGIN CLOSE constraint_cursor; DEALLOCATE constraint_cursor; END;
    IF CURSOR_STATUS('global', 'fk_cursor') >= 0 BEGIN CLOSE fk_cursor; DEALLOCATE fk_cursor; END;
    IF CURSOR_STATUS('global', 'fk_drop_cursor') >= 0 BEGIN CLOSE fk_drop_cursor; DEALLOCATE fk_drop_cursor; END;
    IF CURSOR_STATUS('global', 'fk_recreate_cursor') >= 0 BEGIN CLOSE fk_recreate_cursor; DEALLOCATE fk_recreate_cursor; END;
    IF CURSOR_STATUS('global', 'index_cursor') >= 0 BEGIN CLOSE index_cursor; DEALLOCATE index_cursor; END;
    IF CURSOR_STATUS('global', 'syn_cursor') >= 0 BEGIN CLOSE syn_cursor; DEALLOCATE syn_cursor; END;
    IF CURSOR_STATUS('global', 'synonym_cursor') >= 0 BEGIN CLOSE synonym_cursor; DEALLOCATE synonym_cursor; END;
    IF CURSOR_STATUS('global', 'targets_info_cursor') >= 0 BEGIN CLOSE targets_info_cursor; DEALLOCATE targets_info_cursor; END;
    IF CURSOR_STATUS('global', 'fk_enable_cursor') >= 0 BEGIN CLOSE fk_enable_cursor; DEALLOCATE fk_enable_cursor; END;
    IF CURSOR_STATUS('global', 'remaining_cursor') >= 0 BEGIN CLOSE remaining_cursor; DEALLOCATE remaining_cursor; END;
    IF CURSOR_STATUS('global', 'new_objs_cursor') >= 0 BEGIN CLOSE new_objs_cursor; DEALLOCATE new_objs_cursor; END;
    IF CURSOR_STATUS('global', 'syns_final_cursor') >= 0 BEGIN CLOSE syns_final_cursor; DEALLOCATE syns_final_cursor; END;
    
    -- Cleanup temp tables
    IF OBJECT_ID('tempdb..#RenamedObjects') IS NOT NULL DROP TABLE #RenamedObjects;
    IF OBJECT_ID('tempdb..#RenameLog') IS NOT NULL DROP TABLE #RenameLog;
    IF OBJECT_ID('tempdb..#ForeignKeyDefinitions') IS NOT NULL DROP TABLE #ForeignKeyDefinitions;
    IF OBJECT_ID('tempdb..#Indexes') IS NOT NULL DROP TABLE #Indexes;
    IF OBJECT_ID('tempdb..#Constraints') IS NOT NULL DROP TABLE #Constraints;
END CATCH;

