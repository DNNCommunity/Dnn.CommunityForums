	INNER JOIN {databaseOwner}{objectQualifier}communityforums_Groups as g on g.ForumGroupId = f.ForumGroupId
	INNER JOIN {databaseOwner}{objectQualifier}communityforums_Content as c ON c.ContentId = t.ContentId  
Order By catpriority, categoryname, topicpriority desc, topicsort desc
