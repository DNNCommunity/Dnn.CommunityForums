INNER JOIN {databaseOwner}{objectQualifier}communityforums_Groups as g on g.ForumGroupId = af.ForumGroupId
where authorid = @FilteredUserId

		) as posts INNER JOIN string_split(@ForumIds,':') as fids on cast(fids.value as int) = posts.ForumId 
		INNER JOIN {databaseOwner}{objectQualifier}communityforums_forums as f on posts.ForumId = f.forumid
		INNER JOIN {databaseOwner}{objectQualifier}communityforums_Topics as t on posts.TopicId = t.TopicId 
		INNER JOIN {databaseOwner}{objectQualifier}users as u on u.userid = posts.authorid
		INNER JOIN {databaseOwner}{objectQualifier}TabModules as M ON f.ModuleId = M.ModuleId
		INNER JOIN {databaseOwner}{objectQualifier}communityforums_Groups as g on g.forumgroupid = f.forumgroupid
